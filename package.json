{
  "name": "jacques-daguerre-valcy-portfolio",
  "description": "Portfolio de Jacques-Daguerre Valcy et offre Datakle, propulsé par Payload CMS.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "payload:generate-types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload:bootstrap-admin": "cross-env NODE_OPTIONS=--no-deprecation payload run src/payload/scripts/bootstrapAdmin.ts",
    "payload:migrate-media": "cross-env NODE_OPTIONS=--no-deprecation payload run src/payload/scripts/migrateMedia.ts",
    "payload:seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/payload/scripts/seed.ts",
    "payload:migrate-content": "npm run payload:migrate-media && npm run payload:seed",
    "test": "node --env-file-if-exists=.env --conditions=react-server --import tsx --test 'tests/**/*.test.ts'",
    "verify:routes": "node scripts/verify-routes.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "auth:migrate": "cross-env NODE_OPTIONS=--no-deprecation payload run src/payload/scripts/migrateAuthUsers.ts"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.2",
    "@date-fns/tz": "^1.5.0",
    "@payloadcms/db-mongodb": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-cloud-storage": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@payloadcms/translations": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "graphql": "^16.14.2",
    "ioredis": "^5.9.0",
    "lucide-react": "^1.41.0",
    "mongodb": "^7.6.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.26.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
