# =============================================================================
# Portfolio Jacques-Daguerre Valcy — Payload CMS
# Copier ce fichier en `.env` et renseigner les valeurs.
# NE JAMAIS COMMITER LE FICHIER `.env` (déjà couvert par .gitignore).
# =============================================================================

# --- Base de données -------------------------------------------------------
# URI MongoDB complète, base incluse.
# Railway/Atlas exigent généralement `?authSource=admin`.
# ex. mongodb://user:motdepasse@hote:27017/daguerre_cms?authSource=admin
DATABASE_URI=

# --- Secrets ---------------------------------------------------------------
# Clé de chiffrement Payload. Générer avec :  openssl rand -hex 32
# Changer cette valeur invalide toutes les sessions et les champs chiffrés.
PAYLOAD_SECRET=

# Secret protégeant les URLs de prévisualisation des brouillons.
# Générer avec :  openssl rand -hex 24
PREVIEW_SECRET=

# --- URL publique ----------------------------------------------------------
# Origine publique du site, sans slash final.
# Sert aux URLs canoniques, à Open Graph, au CORS et aux liens de prévisualisation.
# ex. http://localhost:3000  |  https://daguerre-valcy.electrona.online
NEXT_PUBLIC_SERVER_URL=

# --- Stockage des médias ---------------------------------------------------
# `gridfs` : binaires stockés dans MongoDB via GridFS (aucun service externe).
# `s3`     : binaires stockés chez un fournisseur compatible S3 (recommandé en production).
MEDIA_STORAGE_DRIVER=gridfs

# --- S3 (requis uniquement si MEDIA_STORAGE_DRIVER=s3) ---------------------
# Compatible AWS S3, Cloudflare R2, MinIO et équivalents.
S3_BUCKET=
S3_REGION=
# Laisser vide pour AWS S3. Renseigner pour R2 / MinIO.
# ex. https://<account>.r2.cloudflarestorage.com  |  http://localhost:9000
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# `true` pour MinIO et la plupart des S3 auto-hébergés, `false` pour AWS et R2.
S3_FORCE_PATH_STYLE=false

# --- Limitation de débit (optionnel) ---------------------------------------
# URL Redis utilisée pour limiter les soumissions des formulaires publics.
# Si absente, une limitation en mémoire prend le relais (mono-instance uniquement).
REDIS_URL=

# --- Amorçage du premier administrateur (optionnel) ------------------------
# Utilisé uniquement par `npm run payload:bootstrap-admin`, en alternative à la
# saisie interactive. À retirer du fichier une fois les comptes créés.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
