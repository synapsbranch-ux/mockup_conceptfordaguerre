# =============================================================================
# Portfolio Jacques-Daguerre Valcy — Payload CMS
# Copier ce fichier en `.env` et renseigner les valeurs.
# NE JAMAIS COMMITER LE FICHIER `.env` (déjà couvert par .gitignore).
# =============================================================================

# --- Base de données -------------------------------------------------------
# URI MongoDB complète, base incluse.
# Railway/Atlas exigent généralement `?authSource=admin`.
# ex. mongodb://user:motdepasse@hote:27017/daguerre_cms?authSource=admin
DATABASE_URI=

# --- Secrets ---------------------------------------------------------------
# Clé de chiffrement Payload. Générer avec :  openssl rand -hex 32
# Changer cette valeur invalide toutes les sessions et les champs chiffrés.
PAYLOAD_SECRET=

# Secret protégeant les URLs de prévisualisation des brouillons.
# Générer avec :  openssl rand -hex 24
PREVIEW_SECRET=

# --- URL publique ----------------------------------------------------------
# Origine publique du site : protocole + domaine, sans chemin ni slash final.
# Sert aux URLs canoniques, à Open Graph, au CORS et aux liens de prévisualisation.
# ex. http://localhost:3000  |  https://daguerre-valcy.electrona.online
# Le protocole ne doit figurer qu'une fois : « https://https://exemple.fr » place
# le domaine dans le chemin, ce qui met `/api/auth/*` en 404. Le démarrage
# échoue désormais avec un message explicite plutôt que de laisser passer.
NEXT_PUBLIC_SERVER_URL=

# --- Stockage des médias ---------------------------------------------------
# `gridfs` : binaires stockés dans MongoDB via GridFS (aucun service externe).
# `s3`     : binaires stockés chez un fournisseur compatible S3 (recommandé en production).
MEDIA_STORAGE_DRIVER=gridfs

# --- S3 (requis uniquement si MEDIA_STORAGE_DRIVER=s3) ---------------------
# Compatible AWS S3, Cloudflare R2, MinIO et équivalents.
S3_BUCKET=
S3_REGION=
# Laisser vide pour AWS S3. Renseigner pour R2 / MinIO.
# ex. https://<account>.r2.cloudflarestorage.com  |  http://localhost:9000
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# `true` pour MinIO et la plupart des S3 auto-hébergés, `false` pour AWS et R2.
S3_FORCE_PATH_STYLE=false

# --- Limitation de débit (optionnel) ---------------------------------------
# URL Redis utilisée pour limiter les soumissions des formulaires publics.
# Si absente, une limitation en mémoire prend le relais (mono-instance uniquement).
REDIS_URL=

# --- Amorçage du premier administrateur (optionnel) ------------------------
# Utilisé uniquement par `npm run payload:bootstrap-admin`, en alternative à la
# saisie interactive. À retirer du fichier une fois les comptes créés.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# --- Authentification (Better Auth) ----------------------------------------
# Better Auth est le systeme d'identite unique du site : clients et
# administrateurs partagent la meme collection `users`.

# Cle de signature des sessions. DISTINCTE de PAYLOAD_SECRET.
# Generer avec :  openssl rand -hex 32
# La changer invalide toutes les sessions en cours.
BETTER_AUTH_SECRET=

# Connexion Google — methode principale pour les clients.
# Console Google Cloud > API et services > Identifiants > ID client OAuth 2.0.
# URI de redirection autorisee a declarer, exactement :
#   <NEXT_PUBLIC_SERVER_URL>/api/auth/callback/google
# ex. http://localhost:3000/api/auth/callback/google
#     https://daguerre-valcy.electrona.online/api/auth/callback/google
# Laisser vide desactive le bouton « Continuer avec Google » ; la connexion par
# courriel et mot de passe reste disponible.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Reprise des comptes existants (script `npm run auth:migrate`).
# Liste d'adresses, separees par des virgules, dont l'operateur confirme la
# propriete. Elles seront marquees `emailVerified` afin qu'une connexion Google
# rejoigne le compte existant au lieu d'en creer un doublon.
# A retirer une fois la reprise effectuee.
MIGRATION_VERIFIED_EMAILS=

# --- Courriels transactionnels (Resend) ------------------------------------
# Confirmations de rendez-vous, factures, notifications.
# Sans cle, les envois sont signales comme non effectues plutot que simules.
RESEND_API_KEY=
# Expediteur verifie chez Resend. ex. contact@votre-domaine.tld
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
